{
  "name": "manul-mcp-server",
  "displayName": "ManulMcpServer",
  "description": "VS Code extension that publishes ManulEngine (Python) and ManulHeart (Go) as an MCP server and supports .hunt authoring.",
  "version": "0.0.9",
  "publisher": "manul-engine",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "manul",
    "hunt",
    "mcp",
    "automation",
    "manulengine",
    "manulheart",
    "go",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbeatnik/ManulMcpServer"
  },
  "icon": "logo.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "manul.runStep",
        "title": "Run Step",
        "category": "ManulMcpServer",
        "icon": "$(play)"
      },
      {
        "command": "manul.runFile",
        "title": "Run Hunt File",
        "category": "ManulMcpServer",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "manul.runFile",
          "when": "resourceExtname == .hunt",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "manul.runFile",
          "when": "resourceExtname == .hunt",
          "group": "navigation@10"
        }
      ],
      "commandPalette": [
        {
          "command": "manul.runFile",
          "when": "resourceExtname == .hunt || editorLangId == hunt"
        },
        {
          "command": "manul.runStep"
        }
      ]
    },
    "languages": [
      {
        "id": "hunt",
        "aliases": [
          "Hunt",
          "hunt"
        ],
        "extensions": [
          ".hunt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hunt",
        "scopeName": "source.hunt",
        "path": "./syntaxes/hunt.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hunt",
        "path": "./snippets/hunt.json"
      }
    ],
    "keybindings": [
      {
        "command": "manul.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == hunt"
      },
      {
        "command": "manul.runStep",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorLangId == hunt"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "manul.mcp-servers",
        "label": "ManulMcpServer"
      }
    ],
    "configuration": {
      "title": "ManulMcpServer",
      "properties": {
        "manul.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "python",
            "go"
          ],
          "enumDescriptions": [
            "Auto-detect: use ManulHeart (Go) when manul.binaryPath is set or the workspace contains a go.mod, otherwise ManulEngine (Python).",
            "Always use the ManulEngine Python runtime.",
            "Always use the ManulHeart Go runtime (manul.binaryPath)."
          ],
          "default": "auto",
          "description": "Which Manul runtime executes .hunt files: ManulEngine (Python) or ManulHeart (Go)."
        },
        "manul.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the ManulHeart `manul` Go binary. Recommended for the Go runtime because ManulEngine's CLI is also named `manul`, so PATH alone cannot disambiguate them."
        },
        "manul.cdpPort": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Chrome DevTools Protocol port the Go runtime launches Chrome on. 0 auto-picks a free port."
        },
        "manul.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL for the local ManulEngine FastAPI service."
        },
        "manul.sessionId": {
          "type": "string",
          "default": "",
          "description": "Optional fixed session identifier to send with Manul API requests. Leave empty to let the extension generate and persist one."
        },
        "manul.requestTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "HTTP timeout in milliseconds for ManulEngine API calls."
        },
        "manul.logNormalizedDsl": {
          "type": "boolean",
          "default": true,
          "description": "Log normalized DSL when a natural-language step is auto-corrected before execution."
        },
        "manul.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python executable path used by the bundled Manul runner. Leave as python3 to auto-discover a workspace-local .venv first."
        },
        "manul.executablePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom browser or Electron executable. Use with the OPEN APP command for desktop automation."
        },
        "manul.headless": {
          "type": "boolean",
          "default": false,
          "description": "Run the Manul browser session in headless mode."
        },
        "manul.mcpServerLabel": {
          "type": "string",
          "default": "ManulMcpServer",
          "description": "Label shown in VS Code MCP Servers for the ManulMcpServer bridge published by this extension."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit",
    "lint": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:install": "node ./out/lifecycle/install.js",
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./out/lifecycle/uninstall.js",
    "package": "vsce package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.57",
    "@types/vscode": "1.107.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
