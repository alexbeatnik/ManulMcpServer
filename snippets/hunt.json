{
  "Manul Step": {
    "prefix": "step",
    "body": "STEP ${1:1}: ${2:Description}",
    "description": "Insert a STEP header"
  },
  "Manul Navigate": {
    "prefix": "navigate",
    "body": "NAVIGATE to ${1:https://example.com}",
    "description": "Navigate to a URL"
  },
  "Manul Open App": {
    "prefix": "openapp",
    "body": "OPEN APP",
    "description": "Attach to a desktop or Electron app window"
  },
  "Manul Fill": {
    "prefix": "fill",
    "body": "Fill '${1:target}' field with '${2:value}'",
    "description": "Fill an input field"
  },
  "Manul Fill With Verify": {
    "prefix": "fillverify",
    "body": [
      "Fill '${1:target}' field with '${2:value}'",
      "Verify '${1:target}' field has value '${2:value}'"
    ],
    "description": "Fill a field and verify the input value"
  },
  "Manul Click": {
    "prefix": "click",
    "body": "Click the '${1:target}' button",
    "description": "Click a button"
  },
  "Manul Verify": {
    "prefix": "verify",
    "body": "VERIFY that '${1:target}' is present",
    "description": "Verify a target is present"
  },
  "Manul Extract": {
    "prefix": "extract",
    "body": "EXTRACT the '${1:target}' into {${2:variable}}",
    "description": "Extract text into a variable"
  },
  "Manul Wait For": {
    "prefix": "waitfor",
    "body": "Wait for '${1:target}' to ${2|be visible,be hidden,disappear|}",
    "description": "Explicit wait for visibility state"
  },
  "Manul Wait For Response": {
    "prefix": "waitresponse",
    "body": "WAIT FOR RESPONSE \"${1:/api/path}\"",
    "description": "Wait for a matching network response"
  },
  "Manul Import": {
    "prefix": "import",
    "body": "@import: ${1:BlockName} from ${2:source.hunt}",
    "description": "Import STEP blocks from another hunt file"
  },
  "Manul Export": {
    "prefix": "export",
    "body": "@export: ${1:BlockName}",
    "description": "Export STEP blocks for reuse in other hunt files"
  },
  "Manul Use": {
    "prefix": "use",
    "body": "USE ${1:BlockName}",
    "description": "Expand an imported STEP block inline"
  },
  "Manul Setup Block": {
    "prefix": "setup",
    "body": [
      "[SETUP]",
      "    PRINT \"${1:Preparing setup}\"",
      "    CALL PYTHON ${2:module}.${3:function}",
      "[END SETUP]"
    ],
    "description": "Insert a SETUP block"
  },
  "Manul Teardown Block": {
    "prefix": "teardown",
    "body": [
      "[TEARDOWN]",
      "    PRINT \"${1:Cleaning up}\"",
      "    CALL PYTHON ${2:module}.${3:function}",
      "[END TEARDOWN]"
    ],
    "description": "Insert a TEARDOWN block"
  },
  "Manul Done": {
    "prefix": "done",
    "body": "DONE.",
    "description": "Finish the hunt file"
  },
  "Manul If Block": {
    "prefix": "if",
    "body": [
      "IF ${1:condition}:",
      "        ${2:action}"
    ],
    "description": "Conditional branching block"
  },
  "Manul Elif Block": {
    "prefix": "elif",
    "body": [
      "ELIF ${1:condition}:",
      "        ${2:action}"
    ],
    "description": "Alternative branch in an IF block"
  },
  "Manul Else Block": {
    "prefix": "else",
    "body": [
      "ELSE:",
      "        ${1:action}"
    ],
    "description": "Default branch in an IF block"
  },
  "Manul Repeat Loop": {
    "prefix": "repeat",
    "body": [
      "REPEAT ${1:3} TIMES:",
      "        ${2:action}"
    ],
    "description": "Fixed-count loop with {i} counter"
  },
  "Manul For Each Loop": {
    "prefix": "foreach",
    "body": [
      "FOR EACH {${1:item}} IN {${2:items}}:",
      "        ${3:action}"
    ],
    "description": "Iterate over comma-separated variable values"
  },
  "Manul While Loop": {
    "prefix": "while",
    "body": [
      "WHILE ${1:condition}:",
      "        ${2:action}"
    ],
    "description": "Repeat while condition is true (safety limit: 100 iterations)"
  },
  "Manul Call Go": {
    "prefix": "callgo",
    "body": "CALL GO ${1:module}.${2:Function}${3: into {${4:variable}}}",
    "description": "ManulHeart (Go runtime): invoke a registered Go handler inline"
  },
  "Manul Print": {
    "prefix": "print",
    "body": "PRINT \"${1:message}\"",
    "description": "Print a message or {variable} to the console/report"
  },
  "Manul Screenshot": {
    "prefix": "screenshot",
    "body": "SCREENSHOT",
    "description": "ManulHeart (Go runtime): capture a page screenshot"
  },
  "Manul Wait For Element": {
    "prefix": "waitforel",
    "body": "WAIT_FOR '${1:target}'",
    "description": "ManulHeart (Go runtime): wait until an element is present"
  },
  "Manul Call Block": {
    "prefix": "call",
    "body": "CALL ${1:BlockName}",
    "description": "ManulHeart (Go runtime): invoke a reusable STEP block / blueprint"
  },
  "Manul End If": {
    "prefix": "endif",
    "body": "END IF",
    "description": "ManulHeart (Go runtime): explicit IF block terminator"
  },
  "Manul End Repeat": {
    "prefix": "endrepeat",
    "body": "END REPEAT",
    "description": "ManulHeart (Go runtime): explicit REPEAT loop terminator"
  },
  "Manul End For": {
    "prefix": "endfor",
    "body": "END FOR",
    "description": "ManulHeart (Go runtime): explicit FOR EACH loop terminator"
  },
  "Manul End While": {
    "prefix": "endwhile",
    "body": "END WHILE",
    "description": "ManulHeart (Go runtime): explicit WHILE loop terminator"
  }
}